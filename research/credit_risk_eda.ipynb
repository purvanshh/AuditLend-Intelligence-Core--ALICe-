    "---\n",
    "## 3. WOE / IV Analysis\n",
    "\n",
    "**Weight of Evidence (WOE)** measures the strength of each feature in separating defaults from non-defaults.\n",
    "\n",
    "$$\n",
    "WOE_i = \\ln\\left(\\frac{\\% \\text{non-defaults in bin } i}{\\% \\text{defaults in bin } i}\\right)\n",
    "$$\n",
    "\n",
    "**Information Value (IV)** quantifies total predictive power:\n",
    "\n",
    "$$\n",
    "IV = \\sum_i (\\% \\text{non-defaults}_i - \\% \\text{defaults}_i) \\times WOE_i\n",
    "$$\n",
    "\n",
    "| IV Range | Predictive Power |\n",
    "| --- | --- |\n",
    "| < 0.02 | Not useful |\n",
    "| 0.02 — 0.10 | Weak |\n",
    "| 0.10 — 0.30 | Medium |\n",
    "| > 0.30 | **Strong** |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_woe_iv(feature_df, feature, target='target_defaulted', bins=10):\n",
    "    \"\"\"Compute WOE and IV for a numeric feature with equal-width binning.\"\"\"\n",
    "    df = feature_df[[feature, target]].dropna().copy()\n",
    "    \n",
    "    if df[feature].nunique() <= bins:\n",
    "        # Use actual values as bins for low-cardinality features\n",
    "        df['bin'] = df[feature]\n",
    "    else:\n",
    "        df['bin'] = pd.qcut(df[feature], q=bins, duplicates='drop', labels=False)\n",
    "    \n",
    "    total_good = (df[target] == 0).sum()\n",
    "    total_bad = (df[target] == 1).sum()\n",
    "    \n",
    "    grouped = df.groupby('bin')[target].agg(['count', 'sum'])\n",
    "    grouped.columns = ['count', 'bads']\n",
    "    grouped['goods'] = grouped['count'] - grouped['bads']\n",
    "    grouped['pct_goods'] = grouped['goods'] / total_good\n",
    "    grouped['pct_bads'] = grouped['bads'] / total_bad\n",
    "    \n",
    "    # Handle zero-division\n",
    "    grouped['pct_goods'] = grouped['pct_goods'].clip(lower=0.0001)\n",
    "    grouped['pct_bads'] = grouped['pct_bads'].clip(lower=0.0001)\n",
    "    \n",
    "    grouped['woe'] = np.log(grouped['pct_goods'] / grouped['pct_bads'])\n",
    "    grouped['iv'] = (grouped['pct_goods'] - grouped['pct_bads']) * grouped['woe']\n",
    "    \n",
    "    iv_total = grouped['iv'].sum()\n",
    "    return grouped, iv_total"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "key_features = ['dti_ratio', 'revol_util_ratio', 'monthly_income', 'interest_rate_pct',\n",
    "                'credit_score_midpoint', 'loan_amount_to_income', 'existing_emi_to_income',\n",
    "                'credit_history_age_years', 'employment_length_years', 'all_util_ratio']\n",
    "\n",
    "iv_results = {}\n",
    "fig, axes = plt.subplots(5, 2, figsize=(16, 20))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, feat in enumerate(key_features):\n",
    "    if feat not in feature_df.columns:\n",
    "        continue\n",
    "    grouped, iv = compute_woe_iv(feature_df, feat, 'target_defaulted')\n",
    "    iv_results[feat] = round(iv, 4)\n",
    "    \n",
    "    # Plot WOE pattern\n",
    "    ax = axes[i]\n",
    "    ax.bar(range(len(grouped)), grouped['woe'], color='steelblue', edgecolor='white')\n",
    "    ax.axhline(y=0, color='red', linestyle='--', alpha=0.5)\n",
    "    ax.set_xlabel('Bin')\n",
    "    ax.set_ylabel('WOE')\n",
    "    ax.set_title(f'{feat}\\nIV = {iv:.4f}')\n",
    "    ax.grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Print IV table\n",
    "print('\\nInformation Value Summary:')\n",
    "print(f'{\"Feature\":35s} {\"IV\":>10s}  {\"Power\"}')\n",
    "print('-' * 60)\n",
    "for feat, iv in sorted(iv_results.items(), key=lambda x: -x[1]):\n",
    "    if iv > 0.30:\n",
    "        power = 'STRONG'\n",
    "    elif iv > 0.10:\n",
    "        power = 'MEDIUM'\n",
    "    elif iv > 0.02:\n",
    "        power = 'WEAK'\n",
    "    else:\n",
    "        power = 'NOT USEFUL'\n",
    "    print(f'{feat:35s} {iv:>8.4f}  {power}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### WOE/IV Interpretation\n",
    "\n",
    "- **dti_ratio (IV > 0.30 → Strong)**: Debt-to-income ratio is the single most powerful predictor. Higher DTI → negative WOE → higher default risk.\n",
    "- **interest_rate_pct (IV > 0.30 → Strong)**: Interest rate encapsulates the platform's own risk assessment. Higher rates → higher observed default.\n",
    "- **credit_score_midpoint (IV > 0.10 → Medium-Strong)**: FICO scores are predictive but partially redundant with grade.\n",
    "- **revol_util_ratio (IV ~0.10–0.30 → Medium)**: Revolving utilization captures liquidity stress.\n",
    "- **monthly_income (IV < 0.02 → Weak)**: Raw income is weakly predictive on its own; ratios to debt and loan amount matter more.\n",
    "\n",
    "**Business implication**: Models should emphasize DTI and interest rate as primary drivers. Raw income and employment length contribute less than interaction features."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 4. Population Stability Index (PSI)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_psi(expected, actual, bins=10):\n",
    "    \"\"\"Compute Population Stability Index between expected and actual distributions.\"\"\"\n",
    "    expected = expected.dropna()\n",
    "    actual = actual.dropna()\n",
    "    \n",
    "    # Create bins based on expected distribution percentiles\n",
    "    if expected.nunique() <= bins:\n",
    "        # Categorical/ordinal\n",
    "        categories = sorted(set(expected.unique()) | set(actual.unique()))\n",
    "        exp_counts = pd.Series({c: (expected == c).sum() for c in categories})\n",
    "        act_counts = pd.Series({c: (actual == c).sum() for c in categories})\n",
    "    else:\n",
    "        # Numeric: quantile binning\n",
    "        try:\n",
    "            _, bins_arr = np.histogram(expected, bins=bins)\n",
    "        except Exception:\n",
    "            return float('nan')\n",
    "        exp_counts, _ = np.histogram(expected, bins=bins_arr)\n",
    "        act_counts, _ = np.histogram(actual, bins=bins_arr)\n",
    "    \n",
    "    exp_pct = exp_counts / exp_counts.sum()\n",
    "    act_pct = act_counts / act_counts.sum()\n",
    "    \n",
    "    exp_pct = exp_pct.clip(lower=0.0001)\n",
    "    act_pct = act_pct.clip(lower=0.0001)\n",
    "    \n",
    "    psi = ((act_pct - exp_pct) * np.log(act_pct / exp_pct)).sum()\n",
    "    return psi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute PSI between train/validation and train/test for all features\n",
    "train_df = feature_df[feature_df['split'] == 'train']\n",
    "val_df = feature_df[feature_df['split'] == 'validation']\n",
    "test_df = feature_df[feature_df['split'] == 'test']\n",
    "\n",
    "numeric_features = [\n",
    "    'dti_ratio', 'revol_util_ratio', 'monthly_income', 'interest_rate_pct',\n",
    "    'credit_score_midpoint', 'loan_amount_to_income', 'existing_emi_to_income',\n",
    "    'credit_history_age_years', 'employment_length_years', 'all_util_ratio',\n",
    "    'bc_util_ratio', 'il_util_ratio', 'delinquency_burden', 'recent_inquiry_pressure',\n",
    "    'loan_amount', 'funded_amount', 'open_account_density', 'accounts_per_year',\n",
    "    'never_delinquent_ratio', 'credit_inquiry_velocity',\n",
    "]\n",
    "\n",
    "psi_results = {}\n",
    "unstable_features = []\n",
    "\n",
    "for feat in numeric_features:\n",
    "    if feat not in feature_df.columns:\n",
    "        continue\n",
    "    if train_df[feat].nunique() <= 1:\n",
    "        continue\n",
    "    psi_tv = compute_psi(train_df[feat], val_df[feat])\n",
    "    psi_tt = compute_psi(train_df[feat], test_df[feat])\n",
    "    psi_results[feat] = {\n",
    "        'psi_train_vs_val': round(psi_tv, 6) if not np.isnan(psi_tv) else None,\n",
    "        'psi_train_vs_test': round(psi_tt, 6) if not np.isnan(psi_tt) else None,\n",
    "        'stable_train_val': psi_tv < 0.25 if not np.isnan(psi_tv) else True,\n",
    "        'stable_train_test': psi_tt < 0.25 if not np.isnan(psi_tt) else True,\n",
    "    }\n",
    "    if psi_results[feat].get('psi_train_vs_test', 0) or 0 > 0.25:\n",
    "        unstable_features.append(feat)\n",
    "\n",
    "print(f'PSI Analysis: {len(numeric_features)} features')\n",
    "print(f'Features with PSI > 0.25 (unstable): {len(unstable_features)}')\n",
    "if unstable_features:\n",
    "    print(f'Unstable features: {unstable_features}')\n",
    "\n",
    "# Display top 10 most shifted\n",
    "psi_df = pd.DataFrame(psi_results).T\n",
    "psi_df = psi_df.sort_values('psi_train_vs_test', ascending=False, key=lambda x: x.fillna(0))\n",
    "print('\\nTop 10 features by PSI (train vs test):')\n",
    "print(psi_df.head(10).to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save PSI analysis to JSON\n",
    "psi_output = {\n",
    "    'metadata': {\n",
    "        'analysis': 'Population Stability Index',\n",
    "        'train_rows': len(train_df),\n",
    "        'validation_rows': len(val_df),\n",
    "        'test_rows': len(test_df),\n",
    "        'threshold_unstable': 0.25,\n",
    "    },\n",
    "    'features': psi_results,\n",
    "    'unstable_features': unstable_features,\n",
    "}\n",
    "\n",
    "output_path = Path('research/psi_analysis.json')\n",
    "output_path.write_text(json.dumps(psi_output, indent=2))\n",
    "print(f'Saved PSI analysis to {output_path}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### PSI Interpretation\n",
    "\n",
    "- **PSI < 0.10**: No significant shift. Population is stable.\n",
    "- **PSI 0.10 – 0.25**: Moderate shift. Monitor.\n",
    "- **PSI > 0.25**: Significant shift. Investigate and consider retraining.\n",
    "\n",
    "The time-based split (train: 2007–2016, validation: 2017, test: 2018) naturally introduces some drift as economic conditions evolve. Features related to interest rates and loan amounts typically show the highest PSI due to macro trends."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. Hypothesis Testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "### Chi-Square Test: home_ownership vs loan_status\n",
    "\n",
    "contingency = pd.crosstab(feature_df['home_ownership'], feature_df['target_defaulted'])\n",
    "chi2, p_value, dof, expected = stats.chi2_contingency(contingency)\n",
    "\n",
    "print('=== Chi-Square: home_ownership vs Default ===')\n",
    "print(contingency)\n",
    "print(f'\\nChi-Square = {chi2:.4f}')\n",
    "print(f'p-value = {p_value:.6e}')\n",
    "print(f'p < 0.05: {p_value < 0.05} → {\"Reject H0: home_ownership and default are associated\" if p_value < 0.05 else \"Fail to reject H0\"}')\n",
    "print()\n",
    "\n",
    "### Chi-Square Test: purpose vs loan_status\n",
    "contingency2 = pd.crosstab(feature_df['purpose'], feature_df['target_defaulted'])\n",
    "chi2_2, p_value_2, dof_2, expected_2 = stats.chi2_contingency(contingency2)\n",
    "\n",
    "print('=== Chi-Square: purpose vs Default ===')\n",
    "print(f'Chi-Square = {chi2_2:.4f}')\n",
    "print(f'p-value = {p_value_2:.6e}')\n",
    "print(f'p < 0.05: {p_value_2 < 0.05} → {\"Reject H0\" if p_value_2 < 0.05 else \"Fail to reject H0\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "### Mann-Whitney U Test: annual_inc distributions by loan_status\n",
    "\n",
    "paid = feature_df[feature_df['target_defaulted'] == 0]['monthly_income'].dropna()\n",
    "defaulted = feature_df[feature_df['target_defaulted'] == 1]['monthly_income'].dropna()\n",
    "\n",
    "u_stat, p_val_mw = stats.mannwhitneyu(paid, defaulted, alternative='two-sided')\n",
    "\n",
    "print('=== Mann-Whitney U: monthly_income by loan_status ===')\n",
    "print(f'Fully Paid median income: ${paid.median():.2f}')\n",
    "print(f'Defaulted median income: ${defaulted.median():.2f}')\n",
    "print(f'U-statistic = {u_stat:.2f}')\n",
    "print(f'p-value = {p_val_mw:.6e}')\n",
    "print(f'p < 0.05: {p_val_mw < 0.05}')\n",
    "print()\n",
    "\n",
    "### Mann-Whitney U: dti_ratio by loan_status\n",
    "dti_paid = feature_df[feature_df['target_defaulted'] == 0]['dti_ratio'].dropna()\n",
