{
  "title": "AuditLend Drift Monitoring",
  "uid": "auditlend-drift-monitoring",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Drift Alert Rate Per Feature",
      "type": "barchart",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(auditlend_drift_alerts_evidently_total[5m])",
          "legendFormat": "evidently-{{feature}}",
          "refId": "A"
        },
        {
          "expr": "rate(auditlend_drift_alerts_total[5m])",
          "legendFormat": "ks-{{feature}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Drift Score Trend",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "auditlend_drift_alerts_evidently_total",
          "legendFormat": "evidently-{{feature}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Data Drift Share",
      "type": "gauge",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(auditlend_drift_alerts_evidently_total) / on() sum(auditlend_drift_alerts_total)",
          "legendFormat": "drift share",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Report Generation Counter",
      "type": "stat",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "background"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(auditlend_drift_reports_total) by (format)",
          "legendFormat": "{{format}} reports",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      }
    }
  ]
}
